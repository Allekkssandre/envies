# URL publique du site (liens copiés, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — clés publiques (lecture + temps réel)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Secrets de l'app (openssl rand -base64 32)
EDIT_TOKEN_SECRET=
RATE_LIMIT_SALT=
CRON_SECRET=

# Tests e2e uniquement : fenêtre de la limite de déverrouillage, en secondes (défaut 900)
# UNLOCK_WINDOW_SECONDS=60

# Tests e2e uniquement : serveur local de pages produit que l'extraction a le droit de lire.
# Ignoré sur Vercel. Ne jamais le définir en production.
# ENRICH_TEST_ALLOW=127.0.0.1:4599
