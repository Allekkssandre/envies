# URL publique du site (liens copiés, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — clés publiques (lecture + temps réel)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Secrets de l'app (openssl rand -base64 32)
EDIT_TOKEN_SECRET=
RATE_LIMIT_SALT=
CRON_SECRET=

# Tests e2e uniquement : fenêtre de la limite de déverrouillage, en secondes (défaut 900)
# UNLOCK_WINDOW_SECONDS=60

# Tests e2e uniquement : serveur local de pages produit que l'extraction a le droit de lire.
# Ignoré sur Vercel. Ne jamais le définir en production.
# ENRICH_TEST_ALLOW=127.0.0.1:4599

# Secret Santa (docs/13-secret-santa.md)
# Chiffrement du tirage : au moins 32 caractères (openssl rand -base64 32). Ne jamais le changer
# pendant un Secret Santa lancé : les tirages en cours deviendraient illisibles.
SANTA_SECRET_KEY=
# Envoi des mails par Brevo (plan gratuit) : clé API et adresse d'expéditeur validée chez Brevo.
BREVO_API_KEY=
SANTA_MAIL_FROM=
# Facultatif : nom affiché (défaut « Secret Santa · Envies ») et adresse de réponse.
# SANTA_MAIL_FROM_NAME=
# SANTA_MAIL_REPLY_TO=
# Local et tests uniquement : écrit chaque mail en JSON dans ce dossier au lieu de l'envoyer.
# Ignoré sur Vercel.
# SANTA_MAIL_DIR=.santa-mails
